# Copy thành .env rồi điền. KHÔNG commit .env (đã có trong .gitignore).
# Môi trường: tên file trong env/ (dev | stg)
ENV=stg

# Trình duyệt: chrome (Google Chrome cài sẵn, mặc định) | chromium (bản của Playwright) | msedge
BROWSER_CHANNEL=chrome

# Tài khoản CMS theo role (mã role xem data/roles.ts).
# loginId đã có sẵn trong env/<ENV>.json › accounts → ở đây CHỈ cần điền PASSWORD.
# Điền CMS_<role>_ID khi muốn ghi đè loginId. Role thiếu mật khẩu → test của role đó tự skip.
CMS_99_ID=
CMS_99_PASSWORD=
CMS_98_ID=
CMS_98_PASSWORD=
CMS_01_ID=
CMS_01_PASSWORD=
CMS_02_ID=
CMS_02_PASSWORD=
CMS_05_ID=
CMS_05_PASSWORD=

# Tuỳ chọn: ghi đè baseUrl trong env/<ENV>.json
# CMS_BASE_URL=
