# ============================================================
# Copy thành .env: cp .env.example .env — .env CHỈ trên máy này, KHÔNG commit (đã có trong .gitignore)
# Cách điền: viết mật khẩu ngay sau dấu =, không dấu cách, không ngoặc kép.
# loginId lấy sẵn từ env/<ENV>.json › accounts → không cần điền ID.
# Chỉ điền CMS_<role>_ID khi muốn đăng nhập bằng tài khoản KHÁC.
# Role để trống mật khẩu → test của role đó tự skip.
# ============================================================

# Môi trường: dev | stg (tên file trong env/)
ENV=dev

# Trình duyệt: chrome | chromium | msedge
BROWSER_CHANNEL=chrome

# --- Role 99 · CMS Admin · loginId (dev): adminTest1
CMS_99_ID=
CMS_99_PASSWORD=

# --- Role 98 · CMS SubAdmin · loginId (dev): (chưa có tài khoản — hỏi lead)
CMS_98_ID=
CMS_98_PASSWORD=

# --- Role 01 · ChainStore Manager · loginId (dev): linksysmanager00001
CMS_01_ID=
CMS_01_PASSWORD=

# --- Role 02 · ChainStore (cửa hàng) · mặc định loginId: linksysstore00001
#     Các tài khoản store (chọn bằng credentials('02', '<variant>'), danh sách ở env/dev.json › accounts.02.variants):
#       toridoll     linksysstore00001  Toridoll — CÓ encrypt
#       qnavi        linksysstore00002  Qnavi — KHÔNG encrypt
#       urgent       linksysstore00003  trouble luôn là Urgent
#       ringi        linksysstore00004  có setting Ringi
#       autoApprove  linksysstore00005  auto approve
#       approveType1 linksysstore00006  APPROVE TYPE 1
#       approveType2 linksysstore00007  APPROVE TYPE 2
#       approveType3 linksysstore00008  APPROVE TYPE 3
#       ringi0_99    linksysstore00009  Ringi dùng với [0] [99]
#     Cùng 1 mật khẩu cho mọi store → CMS_02_PASSWORD. Store nào khác mật khẩu: thêm CMS_02_<VARIANT>_PASSWORD (vd CMS_02_URGENT_PASSWORD=).
CMS_02_ID=
CMS_02_PASSWORD=

# --- Role 05 · Worker Company (ManagementCompany) · loginId (dev): linksysworkercompany
CMS_05_ID=
CMS_05_PASSWORD=

# Tuỳ chọn: ghi đè cmsBaseUrl trong env/<ENV>.json
# CMS_BASE_URL=
